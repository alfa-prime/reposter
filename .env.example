LOG_LEVEL=INFO

# Общий пул исходящих HTTP-соединений. Обычно значения менять не требуется.
HTTP_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30
# Дополнительные доверенные CA добавляются к системному хранилищу сертификатов.
# HTTP_CA_FILE=/app/certs/russian_trusted_ca.pem
# Включайте только если приложение должно использовать HTTP(S)_PROXY из окружения.
HTTP_TRUST_ENV=false

VK_ACCESS_TOKEN=replace_me
VK_GROUP=peninsula51
VK_API_VERSION=5.199

MAX_ACCESS_TOKEN=replace_me
MAX_API_URL=https://platform-api2.max.ru
# Production webhook MAX. Secret: 5-256 символов A-Z, a-z, 0-9, _ или -.
# MAX_WEBHOOK_URL=https://www.uncle-vlad.ru/api/v1/max/webhook
# MAX_WEBHOOK_SECRET=replace_with_random_secret

# LLM. Сейчас реализован GigaChat, другие провайдеры подключаются через общий интерфейс.
LLM_PROVIDER=gigachat
LLM_TIMEOUT_SECONDS=60
# Ключ авторизации GigaChat из личного кабинета (Base64 Client ID:Client Secret).
# GIGACHAT_CREDENTIALS=replace_me
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

POSTGRES_DB=news_reposter
POSTGRES_USER=news_reposter
POSTGRES_PASSWORD=news_reposter
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_ECHO=false

# Политика серверных пользовательских сессий. Обычно менять не требуется.
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_TOUCH_INTERVAL_MINUTES=5
AUTH_MAX_SESSIONS_PER_USER=5
AUTH_LOGIN_ATTEMPT_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS_PER_USERNAME=5
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20
# В production оставьте true: cookie с префиксом __Host- работают только через HTTPS.
# false допустимо только для локальной разработки по обычному HTTP.
AUTH_COOKIE_SECURE=true

# Публикуется на хосте только в локальной development-конфигурации.
APP_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
# Для локального запуска оставьте :80. Для HTTPS укажите домен, например news.example.ru
SITE_ADDRESS=:80

# Зашифрованные резервные копии PostgreSQL и media volume в S3.
# Создайте отдельные S3-ключи только для этого приватного бакета.
BACKUP_S3_ENDPOINT=https://s3.twcstorage.ru
BACKUP_S3_BUCKET=replace_me
BACKUP_S3_REGION=ru-1
BACKUP_S3_PREFIX=reposter
BACKUP_S3_ACCESS_KEY=replace_me
BACKUP_S3_SECRET_KEY=replace_me
# Отдельный длинный пароль шифрования Restic. Без него восстановление невозможно.
RESTIC_PASSWORD=replace_with_a_long_random_password
BACKUP_HOST_NAME=reposter-production
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
# Доля данных, читаемая при периодической проверке репозитория.
BACKUP_CHECK_SUBSET=5%

# Аварийные уведомления ntfy. Используйте длинное случайное имя темы.
NTFY_URL=https://ntfy.sh/replace_with_a_long_random_topic
# Для зарезервированной темы укажите токен, для случайной анонимной темы оставьте пустым.
NTFY_TOKEN=
MONITOR_HEALTH_URL=https://www.uncle-vlad.ru/health
MONITOR_DATABASE_HEALTH_URL=https://www.uncle-vlad.ru/health/database
MONITOR_DISK_WARNING_PERCENT=75
MONITOR_BACKUP_MAX_AGE_HOURS=26
