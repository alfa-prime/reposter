{$SITE_ADDRESS::80} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy app:8000 {
            header_up X-API-Key {$API_KEY}
        }
    }

    handle /health* {
        reverse_proxy app:8000
    }

    handle /docs* {
        reverse_proxy app:8000
    }

    handle /openapi.json {
        reverse_proxy app:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
