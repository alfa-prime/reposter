{$SITE_ADDRESS} {
    encode zstd gzip

    # Публичный webhook MAX защищён собственным секретом
    # X-Max-Bot-Api-Secret внутри FastAPI.
    handle /api/v1/max/webhook {
        reverse_proxy app:8000
    }

    # FastAPI самостоятельно защищает прикладные маршруты пользовательской
    # сессией, ролями и CSRF. route не даёт try_files переписать /api/*.
    route {
        handle /api/* {
            reverse_proxy app:8000
        }

        handle /health* {
            reverse_proxy app:8000
        }

        handle /docs* {
            reverse_proxy app:8000
        }

        handle /openapi.json {
            reverse_proxy app:8000
        }

        handle {
            root * /srv
            try_files {path} /index.html
            file_server
        }
    }
}
