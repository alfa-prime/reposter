{$SITE_ADDRESS} {
    encode zstd gzip

    basic_auth {
        {$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
    }

    handle /api/* {
        reverse_proxy app:8000 {
            header_up X-API-Key {$API_KEY}
        }
    }

    handle /health* {
        reverse_proxy app:8000
    }

    handle /docs* {
        reverse_proxy app:8000
    }

    handle /openapi.json {
        reverse_proxy app:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
